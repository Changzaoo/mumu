# ──────────────────────────────────────────────────────────────
# radinho.online — NÓ DE BORDA da CDN de áudio (nginx:alpine).
#
# Renderizado pelo entrypoint do nginx:alpine (envsubst em
# /etc/nginx/templates/*.template → /etc/nginx/conf.d/). Variáveis:
#   ORIGIN_IMPORTER   URL do importador (cofre /blob e /stream)
#   ORIGIN_API        URL da API (HLS em /api/v1/stream/)
#   EDGE_CACHE_SIZE   teto do cache em disco (ex.: 20g)
#   CORS_ORIGIN_REGEX origens do app que podem tocar pela borda
#
# O mesmo modelo do Spotify: o cliente fala com a borda, a borda guarda os
# bytes e só vai à origem na primeira vez. Mil pessoas ouvindo a mesma faixa
# = UMA leitura no cofre.
# ──────────────────────────────────────────────────────────────

# Cache em disco. `keys_zone` 128m ≈ 1M de chaves (fatias de 1 MB).
proxy_cache_path /var/cache/nginx/audio
                 levels=1:2
                 keys_zone=audio_cache:128m
                 max_size=${EDGE_CACHE_SIZE}
                 inactive=30d
                 use_temp_path=off;

# A origem responde CORS para a origem de quem pediu PRIMEIRO; em cache, essa
# resposta iria para todo mundo. A borda reescreve o cabeçalho por pedido.
map $http_origin $cors_origin {
    default "";
    "~${CORS_ORIGIN_REGEX}" $http_origin;
}

server {
    listen 80;
    server_name _;
    server_tokens off;

    add_header X-Edge $hostname always;

    location = /edge-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ── Cópia do cofre: /blob/<id>?k=<token-da-cópia> ───────────────────
    # O `k` é da CÓPIA, não do ouvinte: todo mundo que toca a faixa usa o
    # mesmo, então entra na chave sem espalhar o cache — e um `k` errado é
    # sempre miss, que a origem recusa com 403 (nada vaza da borda).
    location /blob/ {
        # Fatias de 1 MB: seek no meio da música busca só a fatia dela, e a
        # faixa vai ficando em cache aos pedaços, conforme é ouvida.
        slice 1m;
        proxy_set_header Range $slice_range;
        proxy_cache audio_cache;
        # Sec-Fetch-Dest muda o corpo (o player recebe sem a capa embutida).
        proxy_cache_key "$uri|$arg_k|$http_sec_fetch_dest|$slice_range";
        proxy_cache_valid 200 206 30d;
        # 503 "reconstruindo"/404/403 nunca entram no cache.
        proxy_cache_lock on;              # 100 pedidos da mesma fatia = 1 ida à origem
        proxy_cache_lock_timeout 10s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_504;
        proxy_cache_background_update on;
        # A origem marca `private` e `Vary: Origin` pensando no navegador; a
        # borda guarda assim mesmo — a chave acima já separa o que precisa.
        proxy_ignore_headers Cache-Control Expires Set-Cookie Vary;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_pass ${ORIGIN_IMPORTER};

        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Vary;
        add_header Access-Control-Allow-Origin $cors_origin always;
        add_header Access-Control-Expose-Headers "Content-Length, Content-Range, X-Cache-Status" always;
        add_header Vary "Origin, Sec-Fetch-Dest" always;
        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Edge $hostname always;
    }

    # ── Extração ao vivo: /stream?url=…&token=<do ouvinte> ──────────────
    # Não dá para guardar (token por pessoa, resposta sem tamanho), mas passa
    # pela borda para o cliente ter um endereço só. Quem junta ouvintes da
    # mesma faixa num transcode é a própria origem (transmissaoCompartilhada).
    location = /stream {
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_ssl_server_name on;
        proxy_pass ${ORIGIN_IMPORTER};

        proxy_hide_header Access-Control-Allow-Origin;
        add_header Access-Control-Allow-Origin $cors_origin always;
        add_header X-Edge $hostname always;
    }

    # ── HLS da API: segmentos imutáveis, manifesto quase sem TTL ─────────
    location ~ ^/api/v1/stream/.+\.(ts|m4s)$ {
        proxy_cache audio_cache;
        proxy_cache_key $uri;             # token fora da chave: segmento é imutável
        proxy_cache_valid 200 30d;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_504;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_pass ${ORIGIN_API};
        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Edge $hostname always;
    }

    location ~ ^/api/v1/stream/.+\.m3u8$ {
        # Manifesto carrega o token do ouvinte: sem cache, só repasse.
        proxy_cache off;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_pass ${ORIGIN_API};
    }

    location / {
        return 404;
    }
}
