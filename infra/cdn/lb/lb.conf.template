# ──────────────────────────────────────────────────────────────
# Balanceador na frente dos nós de borda de UM site (docker-compose.cdn.yml).
#
# `hash $uri consistent` = hash consistente: a mesma faixa cai sempre no
# mesmo nó, então cada nó guarda só a sua parte do catálogo e o cache total
# é a SOMA dos discos, não uma cópia repetida. Nó que cai tem as faixas
# redistribuídas só entre os vizinhos (os outros caches continuam quentes).
#
# `edge` é o nome do serviço no compose: o DNS do Docker devolve um IP por
# réplica (`--scale edge=N`), e cada um vira um peer do upstream.
# ──────────────────────────────────────────────────────────────

resolver 127.0.0.11 valid=10s ipv6=off;

upstream audio_edges {
    hash $uri consistent;
    server edge:80 max_fails=2 fail_timeout=5s;
    keepalive 64;
}

server {
    listen 80;
    server_name _;
    server_tokens off;

    location = /lb-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Nó de borda caiu no meio: tenta o próximo do anel.
        proxy_next_upstream error timeout http_502 http_504;
        proxy_next_upstream_tries 2;
        proxy_buffering off;              # a borda já bufferiza; aqui é só roteamento
        proxy_read_timeout 300s;
        proxy_pass http://audio_edges;
    }
}
