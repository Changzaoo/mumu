# Importador do radinho no vnmax — cópia de /home/v/aurial/importer.env (sem segredos).
# Segredos (IMPORT_SERVICE_TOKEN, NVIDIA_API_KEY) ficam em /home/v/aurial/segredos.env.
PORT=8787
# 0.0.0.0: o túnel (localhost) e os contêineres da API (IP Tailscale do host) chegam.
HOST=0.0.0.0
BLOB_DIR=/home/v/aurial/cofre
# Antessala pequena: o acervo mora no GitHub (infra/scripts/musicas-para-o-git.mjs).
MAX_BLOB_GB=2
COFRE_EXIGE_MARCADOR=0
MIN_FREE_MB=2048
# Invólucro: injeta --js-runtimes node (o importador passa --ignore-config e perderia
# o ~/.config/yt-dlp/config; sem isso o YouTube dá 403 nos bytes) e guarda o stderr.
YTDLP_PATH=/home/v/aurial/yt-dlp.sh
FFMPEG_PATH=/usr/bin
YTDLP_COOKIES=/home/v/aurial/cookies.txt
FIREBASE_PROJECT_ID=mumu-2f54e
IMPORT_REQUIRE_LOGIN=1
IMPORT_ALLOWED_EMAILS=
ALLOW_ORIGIN=*
TMPDIR=/home/v/aurial/work
PYTHON_PATH=/usr/bin/python3
JEV_DIR=/home/v/aurial/jev
JEV_MODELOS_DIR=/home/v/aurial/jev/modelos
TEMPO_DIR=/home/v/aurial/tempos
AUDIO_RELOGIO_GB=1
# Um trabalho pesado por vez (2 núcleos).
MAX_RESOLUCOES=1
MAX_RECONSTRUCOES=1
STREAM_CACHE_MB=128
# Sem GPU: modelos pequenos. A transcrição livre é só reserva da NVIDIA.
WHISPER_MODELO=small
WHISPER_MODELO_TRANSCRICAO=small
