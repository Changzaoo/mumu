rules_version = '2';

// radinho.online — Firestore security rules (cross-device sync + community trending).
// Paste these into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Quem administra o acervo do app. MESMA lista do cliente
    // (apps/web/src/lib/auth/roles.ts) — as duas precisam andar juntas.
    function ehAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'perdibitcoin@gmail.com',
          'redcanidsvinicius@gmail.com'
        ];
    }

    // Per-user private data (likes, playlists, library). Only the owner may
    // read or write their own space.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ACERVO DO APP — o que o admin adiciona, todo mundo ouve.
    //
    // Sem isto, "as músicas do app" eram na verdade a biblioteca PRIVADA de
    // quem as importou (users/{uid}/library, que só o dono lê). O usuário comum
    // abria o app e via a própria biblioteca vazia, porque não existia nenhum
    // acervo compartilhado — só a vitrine da comunidade, limitada e escondida.
    //
    // Leitura aberta de propósito: o app funciona para visitante (prévia de
    // 30s), e é o acervo que dá o que ouvir antes de criar conta.
    // ESCRITA POR QUALQUER CONTA LOGADA, DE PROPÓSITO.
    //
    // A primeira versão exigia `ehAdmin()` — o e-mail do token numa lista fixa.
    // Ela negou TODAS as escritas e o acervo ficou vazio por dias, sem ninguém
    // conseguir dizer por quê: leitura liberada, regra publicada, escrita
    // recusada em silêncio. Duas contas fazem a lista falhar sem aviso: entrar
    // com outro e-mail, e entrar de forma ANÔNIMA — aí o token não tem e-mail
    // nenhum e a comparação nunca casa.
    //
    // O que se perde: qualquer pessoa logada pode escrever no acervo. Numa
    // plataforma aberta isso seria inaceitável; aqui é um app com um punhado de
    // usuários conhecidos, e o cliente só publica faixas da PRÓPRIA biblioteca
    // (nunca as emprestadas do acervo) — na prática vira acervo comunitário,
    // que é o mesmo modelo já usado em `sharedTracks` logo abaixo.
    //
    // Para voltar a restringir depois, sem repetir o erro: troque por uma
    // comparação de UID (`request.auth.uid == '...'`), que existe em TODA
    // sessão, inclusive anônima — o e-mail não.
    match /catalogo/{trackId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Community trending: public to read (the "em alta" feed); any signed-in
    // user may contribute a like. Note: the like counter is client-incremented,
    // which is fine for a personal app — move to a Cloud Function to fully
    // prevent tampering.
    match /trending/{trackId} {
      allow read: if true;
      allow write: if request.auth != null;

      // One vote doc per user guards double-counting; only its owner touches it.
      match /voters/{uid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Telemetria (página /telemetria do admin): cada usuário escreve apenas o
    // PRÓPRIO doc; somente os admins da allow-list conseguem ler.
    match /telemetry/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null
        && request.auth.token.email in [
          'perdibitcoin@gmail.com',
          'redcanidsvinicius@gmail.com'
        ];
    }

    // Compartilhamentos por link (/s/:id): qualquer pessoa COM O LINK pode ler
    // (a página funciona sem login); só usuários logados criam, e o doc é
    // imutável depois de criado.
    match /shares/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.byUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Community shared library: link-imported tracks visible to every user.
    // The FIRST sharer owns the entry — only they can update it, and nobody can
    // relabel/reorder someone else's (enforced server-side).
    match /sharedTracks/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.sharedByUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.sharedByUid == request.auth.uid
        && request.resource.data.sharedByUid == request.auth.uid
        && request.resource.data.sharedAt == resource.data.sharedAt;
      allow delete: if false;
    }
  }
}
