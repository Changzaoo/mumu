# radinho.online web — copy to apps/web/.env.local
# Without Firebase vars the app boots in demo mode (auth disabled).

VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=http://localhost:4000

# Firebase Web SDK (Project Settings > General > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# P2P (compartilhamento entre pares). Todas opcionais: sem elas o app usa o
# sinalizador na mesma origem (`/rtc`) e só STUN público.
# ⚠ Tudo que começa com VITE_ vai para o bundle e é PÚBLICO. Nunca ponha aqui
# uma credencial de TURN de longa duração: use credencial efêmera (TURN REST,
# usuário `timestamp:nome` com validade curta) ou um servidor TURN descartável.
VITE_SIGNALING_URL=
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_PASS=
